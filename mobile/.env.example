# Copy this file to .env (git-ignored) and fill in real values.
# These are the same public-safe values already used by the website
# (my-project/.env.local) — see SETUP.md.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=

# The deployed website's URL — its /api/* functions are this app's backend.
EXPO_PUBLIC_API_BASE_URL=
